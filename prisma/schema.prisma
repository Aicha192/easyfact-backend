generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Entreprise {
  id         Int         @id @default(autoincrement())
  nom        String
  email      String
  telephone  String
  adresse    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  clients    Client[]
  factures   Facture[]
  parametres Parametres?
  produits   Produit[]
  proformas  Proforma[]
  users      User[]
  factureSequences FactureSequence[]
}

model Client {
  id           Int         @id @default(autoincrement())
  nom          String
  email        String
  telephone    String
  adresse      String
  statut       String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  entrepriseId Int?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  @@index([entrepriseId], map: "Client_entrepriseId_fkey")
}

model Produit {
  id           Int        @id @default(autoincrement())
  reference    String
  nom          String
  categorie    String
  prix         Float
  unite        String
  statut       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  entrepriseId Int
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  @@index([entrepriseId], map: "Produit_entrepriseId_fkey")
}

model Facture {
  id           Int           @id @default(autoincrement())
  numero       String
  client       String
  dateEmission DateTime
  dateEcheance DateTime
  montantHT    Float
  tva          Float
  montantTTC   Float
  statut       String
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  entrepriseId Int
  entreprise   Entreprise    @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  items        FactureItem[]

  @@index([entrepriseId], map: "Facture_entrepriseId_fkey")
@@unique([entrepriseId, numero])
}

model FactureItem {
  id           Int     @id @default(autoincrement())
  designation  String
  quantite     Float
  prixUnitaire Float
  total        Float
  factureId    Int
  facture      Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([factureId], map: "FactureItem_factureId_fkey")
}

model Proforma {
  id            Int            @id @default(autoincrement())
  numero        String
  client        String
  dateEmission  DateTime
  dateValidite  DateTime
  montantHT     Float
  tva           Float
  montantTTC    Float
  statut        String
  notes         String?
  factureNumero String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  entrepriseId  Int
  entreprise    Entreprise     @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  items         ProformaItem[]

  @@index([entrepriseId], map: "Proforma_entrepriseId_fkey")
}

model ProformaItem {
  id           Int      @id @default(autoincrement())
  designation  String
  quantite     Float
  prixUnitaire Float
  total        Float
  proformaId   Int
  proforma     Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId], map: "ProformaItem_proformaId_fkey")
}

model Parametres {
  id                 Int        @id @default(autoincrement())
  nomEntreprise      String
  responsable        String
  adresse            String
  telephone          String
  email              String
  siteWeb            String
  ninea              String
  rccm               String
  devise             String
  conditionsPaiement String
  logo               String     @db.LongText
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  entrepriseId       Int        @unique
  entreprise         Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
}

model User {
  id           Int         @id @default(autoincrement())
  nom          String
  email        String      @unique
  telephone    String
  password     String
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  role         String
  avatar       String?     @db.LongText
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  entrepriseId Int?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  @@index([entrepriseId], map: "User_entrepriseId_fkey")
}

model FactureSequence {
  id            Int        @id @default(autoincrement())
  entrepriseId  Int
  annee         Int
  dernierNumero Int        @default(0)
  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  @@unique([entrepriseId, annee])
  @@index([entrepriseId])
}
