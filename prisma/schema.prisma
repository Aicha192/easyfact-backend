// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Entreprise {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String
  telephone String
  adresse   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  clients    Client[]
  produits   Produit[]
  parametres Parametres?
  factures   Facture[]
  proformas  Proforma[]
}

model Client {
  id           Int         @id @default(autoincrement())
  nom          String
  email        String
  telephone    String
  adresse      String
  statut       String
  entrepriseId Int?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Produit {
  id           Int        @id @default(autoincrement())
  reference    String
  nom          String
  categorie    String
  prix         Float
  unite        String
  statut       String
  entrepriseId Int
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Facture {
  id           Int           @id @default(autoincrement())
  numero       String
  client       String
  dateEmission DateTime
  dateEcheance DateTime
  montantHT    Float
  tva          Float
  montantTTC   Float
  statut       String
  notes        String?
  entrepriseId Int
  entreprise   Entreprise    @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  items        FactureItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model FactureItem {
  id           Int     @id @default(autoincrement())
  designation  String
  quantite     Float
  prixUnitaire Float
  total        Float
  factureId    Int
  facture      Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
}

model Proforma {
  id            Int            @id @default(autoincrement())
  numero        String
  client        String
  dateEmission  DateTime
  dateValidite  DateTime
  montantHT     Float
  tva           Float
  montantTTC    Float
  statut        String
  notes         String?
  factureNumero String?
  items         ProformaItem[]
  entrepriseId  Int
  entreprise    Entreprise     @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProformaItem {
  id           Int      @id @default(autoincrement())
  designation  String
  quantite     Float
  prixUnitaire Float
  total        Float
  proformaId   Int
  proforma     Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
}

model Parametres {
  id                 Int    @id @default(autoincrement())
  nomEntreprise      String
  responsable        String
  adresse            String
  telephone          String
  email              String
  siteWeb            String
  ninea              String
  rccm               String
  devise             String
  conditionsPaiement String
  logo               String @db.LongText

  entrepriseId Int        @unique
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int         @id @default(autoincrement())
  nom          String
  email        String      @unique
  telephone    String
  password     String
  role         String
  avatar       String?     @db.LongText
  entrepriseId Int?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
